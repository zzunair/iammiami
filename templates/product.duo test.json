    "custom_liquid_f3xVX9": {
      "type": "custom-liquid",
      "disabled": true,
      "settings": {
        "custom_liquid": "<style>\n\n/* do not delete or hide  */\nbody.template-collection,\nbody.template-product {\n  --color-background: #f3f3f3;\n  --body-bg: #f3f3f3;\n}\nbody {\n --iamcolor_bundle: {{ product.metafields.custom.bundle_color | default: \"var(--iamcolor)\" }};\n}\n.productView-action .button {\nbackground: var(--iamcolor_bundle);\n  border-color: var(--iamcolor_bundle);\n  transition: .25s !important\n}\n/* product image fixes * /\n.productView .productView-image-wrapper .productView-image .productView-img-container {\n  padding-bottom:calc(100% - 40px) !important;\n}\n@media only screen and (max-width: 1024px) { .productView-image .productView-img-container {\n  padding-bottom:calc(100% - 20px) !important;;\n  }\n}\n/* complimentary products */\n.complementary-products-slider .slick-dots {\n  bottom:-25px;\n}\n.productView-complementary.style-1 .complementary-products-title .title .text {\n    padding: 35px 0 25px;\n  text-transform: uppercase;\n  text-align: center;\n  font-size: 20px;\n}\n@media (min-width: 1025px) {\n  .productView-complementary.style-1 .complementary-products-title .title .text {\n    padding: 35px 0 25px;\n  }\n    font-size: 25px;\n}\n.complementary-products-slider .product-item {\n  border-width: 1px !important;\n\n}\n.complementary-products-slider .product-item .card-information {\n  display: none;\n}\n@media (max-width: 420px) {\n}\n/* price */ \n.price__regular { \n  position: relative;\n}\n.productView-price .price__regular:after { \n  position: relative;\n  content: '';\n  display: block;\n  width: 100%;\n  height: 3px;\n  background-color: #c00;\n  position: absolute;\n  top:50%;\n  left: 50%;\n  transform: translate(-50%, -50%) rotate(-10deg);\n}\n\n\n/* product cards */\n\n\n.card-action .button, .productView-action .button {\ncolor:#fff;\nborder-radius:.375em !important;\nfont-size: clamp(1.5rem, 1.625vw, 2rem) !important;\nline-height:1;\nmargin: 0  auto !important;\npointer-events: all;\nfont-weight: 900; \n}\n\n.card-action .button {\n  border: .125em solid #fff;\n  box-shadow:0 .125em .5em #0004;\n  background: #8885;\n  text-shadow: 0 1px 2px #0003;\n  width: fit-content;\n  padding: .5em 1em !important;\nbackdrop-filter: blur(4px);\ntransition: 0s !important;\n}\n.card-group-abs-center,\n.card-action {\n  transition: 0s !important;\n}\n\n.product-card-layout-03 .card-action {\n  margin: 0 auto !important;\n  max-width:100%;\n}\n .productView-action .button:hover {\nborder-color:var(--iamcolor_bundle);\ncolor:var(--iamcolor_bundle);\n}\n.card-action .button:hover {\n  background: var(--iamcolor_bundle);\n  color:#fff;\n  border: .125em solid #fff;\n  text-shadow: 0 1px 2px #0003;\n  backdrop-filter: blur(10px);\n}\n@media (max-width: 1024px) {\n\n .product-card-layout-03 .product-tab-block .product-item  .card-action  { \n     margin-top:-8px !important;\n     padding-bottom: 15px !important;\n} \n.product-card-layout-03 .complementary-products-slider .product-item  .card-action  { \n     padding-bottom: 15px !important;\n       margin-top:-4.5em !important;\n}\n.product-tab-block .card-action .button { \n      background: var(--iamcolor_bundle);\n  }\n\n/*\n.product-card-layout-03 .product-item .card-action {\n  margin-top:0 !important;;\n}\n  */\n\n}\n@media (max-width: 767px) {\n .product-card-layout-03 .product-tab-block .product-item  .card-action  { \n     margin-top:0 !important;\n     padding-bottom: 10px !important;\n} \n\n}\n\n@media (max-width: 600px) {\n .product-card-layout-03 .product-tab-block .product-item  .card-action  { \n     margin-top:0 !important;\n     padding-bottom: 5px !important;\n} \n\n}\n\n\n/* suggested products cards * /\n\n@media (max-width: 1024px) {\n  .product-card-layout-03 .card-action,\n   .products-grid .product .card-action, .products-carousel .product .card-action {\n    display: block !important;\n    margin-top:0 !important;\n    padding-bottom: 15px !important;\n}\n\n}\n@media (max-width: 767px) {\n  .custom-image-banner-block .content_absolute .content h3 .link_title span:before {\n    content:normal;\n  }\n  .grouped_btn--slider {\n    bottom: 12%;\n  display: flex;\n  gap: .75em;\n  }\n  .product-card-layout-03 .card-action,\n  .products-grid .product .card-action, .products-carousel .product .card-action {\n   display: block !important;\n   margin-top:0 !important;\n   padding-bottom: 5px !important;\n}\n\n  .card-action .button, .productView-action .button { \nfont-size: clamp(1.5rem, 3.875vw, 16px)!important;\n    margin: 0 auto !important;\n  }\n}\n@media (max-width: 600px) {\n  .card-action .button, .productView-action .button {\n    font-size:15px !important;\n  }\n  .card-action .button {\n    width: fit-content !important;\n  } \n  .product-card-layout-03 .card-action,\n  .products-grid .product .card-action, .products-carousel .product .card-action {\n   display: block !important;\n   margin-top:0 !important;\n\n   padding-bottom: 0 !important;\n}\n}\n/* */\n@media (hover: hover) {\n.card-action .button:hover, .productView-action .button:hover {\n    animation: style_hover .375s ease-out forwards ; \n  }\n}  \n\n\n\n\n\n\n/* page styles */\n\n\n.halo-text-format #tab-description-mobile :first-child {\nmargin-top:0 !important;\n}\n:root {\n  --cyl_background:{{ product.metafields.custom.complete_your_look_background }} ;\n  --cyl_text:{{ product.metafields.custom.text_complete_your_look }} ;\n  --ymal_background:{{ product.metafields.custom.background_you_may_also_like }} ;\n  --ymal_text:{{ product.metafields.custom.text_you_may_also_like }} ;\n}\n@media only screen and (max-width: 550px) {\n  .tabs-contents .tab-popup-header {\n  display:none;\n  }\n  .tabs-contents .tab-popup-content :first-child {\nmargin-top:0;\n}\n\n  .tabs-contents .tab-popup-content {\npadding-bottom:22px;\n}\n}\n  .tabs-contents .tab-popup-content ul {\npadding-bottom:0;\n}\n.gpo-app .gpo-swatches input + label:hover .gpo-tooltip {\ndisplay:none;\n}\n/* review block */\n.jdgm-rev-widg .jdgm-star, .jdgm-revs-tab .jdgm-star, .jdgm-all-reviews .jdgm-star, .jdgm-gallery-popup .jdgm-star,\n.jdgm-sort-dropdown-wrapper .jdgm-sort-dropdown, .jdgm-sort-dropdown-wrapper .jdgm-sort-dropdown-arrow {\n  color:var(--iamcolor_bundle) !important;\n}\n.jdgm-write-rev-link.jdgm-write-rev-link,.jdgm-histogram__bar-content,\n.jdgm-rev[data-verified-buyer=\"true\"] .jdgm-rev__icon.jdgm-rev__icon::after, .jdgm-rev__buyer-badge.jdgm-rev__buyer-badge {\n  background-color: var(--iamcolor_bundle) !important;\n  border-color: var(--iamcolor_bundle) !important\n}\n\n.jdgm-rev__author {\n  color:#000 !important;\n  font-weight: 700;\n}\n.jdgm-rev__icon, .jdgm-verified-checkmark {\n  display: none !important;\n}\n.jdgm-all-reviews__summary-text--verified {\n  justify-content: center !important;\n}\n.jdgm-sort-dropdown-wrapper {\n  margin: 0 0 0 auto !important;\n  display: block !important;\n  width: fit-content;\n}\n.jdgm-sort-dropdown-arrow {\n  display: block;\n  top: .5em;\n}\n.productView-tab .tab-content svg {\n  fill:var(--iamcolor_bundle) !important;\n  stroke:var(--iamcolor_bundle) !important;\n}\n.productView-tab .tab-content .icon-dropdown {\n  z-index: 0 !important;\n}\n\n\n\n\n\n\n .card-product .card-media.media--hover-effect > img {\n    transition: all .3s ease;\n}\n.card-product:hover .card-media.media--hover-effect > img:first-child:not(:only-child)  {\n   opacity: 1 !important;\n  z-index: 1;\n    transform: scale(1.05);\n        transition: all .3s ease;\n\n}\n .card-product:hover .card-media.media--hover-effect > img + img\n, .card-product .card-media.media--hover-effect > img + img {\n\n             transform: none;\n  z-index: -1;\n  visibility: hidden;\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n.complementary-products-slider .card-product:hover .card-media.media--hover-effect > img:first-child:not(:only-child)  {\n\n     transform: none;\n  z-index: -1;\n  visibility: hidden;\n\n}\n.complementary-products-slider .card-product:hover .card-media.media--hover-effect > img + img\n,.complementary-products-slider .card-product .card-media.media--hover-effect > img + img {\n   opacity: 1 !important;\n  z-index: 1;\n    transform: scale(1.05);\n        transition: all .3s ease;\n}\n</style>"
