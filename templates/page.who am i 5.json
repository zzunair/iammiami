      "settings": {
        "custom_liquid": "<style>\n\n/* */\nbody.toolbar-modal-open .toolbar .dropdown-menu.hidden-on-desktop {\n  padding-bottom: 46px;\n}\n@media (max-width: 1024px) {\n  .toolbar .toolbar-dropdown.filter-sortby .label-tab.hidden-on-desktop {\n    padding: 4px 21px 4px 0 !important;\n  }\n  .toolbar .toolbar-dropdown .label-tab.hidden-on-desktop .icon-dropdown {\n    right: 5px;\n  }\n}\n.productList li {\n  max-width: 990px;\n  display: block !important;\n}\n\n.card-product:hover .card-media > img {\n  opacity: 1; \n  transform: scale(1.05);\n  transition: opacity .5s,transform .5s cubic-bezier(0,0,.44,1.18),-webkit-transform .5s cubic-bezier(0,0,.44,1.18);\n}\n/*\n.card-link {z-index: 11 !important;\n}*/\n.productList .card-information__wrapper .card-information__group .card-vendor,\n.productList .card-information__wrapper .card-title {\n  font-weight: 900;\n  font-size: 30px;\n  height: auto;\n  margin:20px 0 ;\n}\n.productList .card-information {\n  max-width: 600px;\n  display: flex !important;\n  flex-direction: column;\n  justify-content: space-between;\n}\n.productList .card-information,\n.productList li {\n  margin-right: auto;\n  margin-left: auto;\n}\n@media (min-width: 992px) {\n  .productList.list-4 .card-product,\n  .productList.list-5 .card-product {\n    width: calc(35% - 8px);\n  }\n}\n.variants-popup, .productList .card-list__hidden {\ndisplay:none;\n}\n.productListing .product {\n  cursor: pointer;\n}\n\n.productListing .card-action form {\n  display: none;\n}\n  /* do not delete or hide  */\n  body.template-collection,\n  body.template-product {\n    --color-background: #f3f3f3;\n    --body-bg: #f3f3f3;\n  }\n  .card-group-abs-center,\n  .card-action {\n    transition: 0s !important;\n  }\n  @media (max-width: 1024px) {\n   .productList  .card-media + .card-group-abs-center {\n      display: none;\n    }\n    .product-card-layout-01 .product-item .card-action, .product-card-layout-04 .product-item .card-action, .product-card-layout-03 .product-item .card-action, .product-card-layout-07 .product-item .card-action {\n      display: block !important;\n      margin-top:-3.5em !important;\n      padding-bottom: 15px !important;\n  } \n\n\n  }\n\n\n  @media (max-width: 767px) {\n   .productList.productListing .product .card-summary.card-list__hidden {\n      display:block !important;\n    }\n    .custom-image-banner-block .content_absolute .content h3 .link_title span:before {\n      content:normal;\n    }\n    .grouped_btn--slider {\n      bottom: 12%;\n    display: flex;\n    gap: .75em;\n    }\n    .product-card-layout-01 .product-item .card-action, .product-card-layout-04  .product-item .card-action, .product-card-layout-03 .product-item .card-action, .product-card-layout-07 .product-item .card-action{\n     display: block !important;\n     margin-top:-3em !important;\n     padding-bottom: 5px !important;\n  }\n\n  /* D&T cards */\n.card-product .card-media.media--hover-effect > img:first-child:not(:only-child) {\n    transition: all .3s ease;\n}\n.card-product:hover .card-media.media--hover-effect > img:first-child:not(:only-child)  {\n  opacity: 1 !important;\n  z-index: 1;\n    transform: scale(1.05);\n\n}\n.card-product:hover .card-media.media--hover-effect > img + img\n,.card-product .card-media.media--hover-effect > img + img {\n  transform: none;\n  z-index: -1;\n  visibility: hidden;\n}\n\n/* */\n  </style>\n  <style>\n@media (hover: hover) {\n  .slideshow .slide-content .slide-button:hover,\n.custom-image-banner-block .content_absolute:hover .content h3,\n.card-action .button:hover,\n.productListing .card-action:hover:before {\n    animation: style_hover .375s ease-out forwards ; \n  }\n}  \n  /* */\n\n.toolbar .toolbar-item .toolbar-icon[aria-label=\"List\"] {\n  display: none;\n}\n@media (max-width: 550px) {\n  .toolbar .toolbar-item .toolbar-icon[aria-label=\"List\"] {\ndisplay: inline-block;\n}\n  .toolbar {\n    border-top: none;\n    padding:  0 !important;\n  }\n}\n\n\n@media (max-width: 1024px) {\n  .toolbar-wrapper:not(.toolbar-mobile) + .toolbar-mobile {\n    justify-content: left;\n    order: 2;\n    flex-grow: 1;\n  }\n}\n\n\n@media (min-width: 551px) {\n  .toolbar {\n    display: none;\n  }\n}\n@media (min-width: 360px) {\n  .productGrid .product, .productGrid.column-2 .product, .productGrid.column-3 .product, .productGrid.column-4 .product, .productGrid.column-5 .product {\n  width: 33.3333333%;\n    margin-top: 30px !important;\n  }\n\n  @media (max-width: 970px) {\n  .productGrid .product, .productGrid.column-2 .product, .productGrid.column-3 .product, .productGrid.column-4 .product, .productGrid.column-5 .product {\n  width: 50%;\n  }\n}/* */\n  @media (max-width: 600px) {\n  .productGrid .product, .productGrid.column-2 .product, .productGrid.column-3 .product, .productGrid.column-4 .product, .productGrid.column-5 .product {\n  width: 100%;\n  max-width: 400px;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  display: block;\n  }\n  .main-collection-product-grid {\n  \n  }\n    .toolbar {\n    display: none;\n  }\n}\n@media (max-width: 359px) {\n  .toolbar {\n    display: none;\n  }\n}\n</style>"
