    "custom_liquid_H74YTx": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* header colors & slides\nProduct scroller and button animations\n*/\n[data-index=\"1\"] {\n  --bc: #3267a3;\n  --bc: #74b6ba;--bc: #feb6cf;\n}\n[data-index=\"2\"] {\n  --bc: #ff9421;\n  --bc: #feb6cf;\n  --bc: #ec196e;\n}\n[data-index=\"3\"] {\n  \n  --bc: #ec196e;\n  --bc: #feb6cf;\n}\n[data-index=\"4\"] {\n  --bc: #3267a3;\n  --bc: #ff9421;\n  --bc: #74b6ba;\n}[data-index=\"5\"] {\n  --bc: #ff9421;\n  --bc: #3267a3;\n}\n[data-index=\"6\"] {\n  --bc: #e5bf23;\n  --bc: #feb6cf;\n  --bc: #ff9421;\n}\n[data-index=\"7\"] {\n  --bc: #ec196e;\n  --bc: #e5bf23;\n  --bc: #ec196e;\n}\n[data-index=\"8\"] {\n  --bc: #74b6ba;\n}\n[data-index=\"9\"] {\n  --bc: #ec196e;\n}\n[data-index=\"10\"] {\n  --bc: #74b6ba;\n}\n\n.custom-image-banner-block .content_absolute .content h3 .link_title span:before {\n  content:'Shop ';\n}\n.slideshow .slide-content {\n  top:auto;\n  bottom:80px;\n}\n\n.slideshow .slide-content .slide-button,\n.custom-image-banner-block .content_absolute .content h3,\n.card-action .button {\n  background: #8885;\nbox-shadow:0 .125em .5em #0004;\ncolor:#fff;\n  border: .125em solid #fff;\n  width: fit-content;\n  padding: .5em 1em !important;\nborder-radius:.375em;\nfont-size: clamp(1.5rem, 1.625vw, 2rem);\nline-height:1;\nbackdrop-filter: blur(4px);\ntransition: .5s;\ntext-shadow: 0 1px 2px #0003;\nmargin: 0  auto !important;\npointer-events: all;\nfont-weight: 900; min-width: 0;\n --mg-bottom-title-style: 5px !important;\n--mg-bottom-title-style-mb: 5px !important;\n}\n.product-card-layout-03 .card-action {\n  margin: 0 auto !important;\n  max-width:100%;\n}\n.custom-image-banner-block .content_absolute .content {\n  -moz-transform: translate(-50%,-75%) !important;\n  -o-transform: translate(-50%,-75%) !important;\n  -ms-transform: translate(-50%,-75%) !important;\n  -webkit-transform: translate(-50%,-75%) !important;\n  transform: translate(-50%, -75%);\n  overflow: visible;\n  --align-items-spacing-style: 0 !important;\n  --align-items-spacing-lr-style: 0 !important;\n}\n.slideshow .slide-content .slide-button:hover,\n.custom-image-banner-block .content_absolute:hover .content h3,\n.card-action .button:hover {\n  background: var(--bc);\n  color:#fff;\n  border: .125em solid #fff;\n  text-shadow: 0 1px 2px #0003;\n  backdrop-filter: blur(10px);\n}\n.custom-image-banner-block .content_absolute:hover .content h3\n  {}\n.custom-image-banner-block .content_absolute:hover .content h3,\n.card-action .button:hover {\n  background: var(--iamcolor);\n}\n.grouped_btn--slider {\n  justify-content: center;\n  gap: 2em;\n  align-self:flex-end;\nwidth: 100%;\nposition:absolute;\nbottom:125px;\nleft:0;\n}\n\n@media (max-width: 1199px) {\n  .slideshow .slide-content {\n    top: auto;\n    bottom: 35px;\n  }\n  }\n  @media (max-width: 1024px) {\n  .custom-image-banner-block .content_absolute .content.align-items--bottom {\n    padding-bottom: 0 !important;\n  }\n  .product-card-layout-03 .card-action {\n   display: block !important;\n   margin-top:-3.5em !important;\n}\n.product-card-layout-01 .product-item .card-action, .product-card-layout-04 .product-item .card-action, .product-card-layout-03 .product-item .card-action, .product-card-layout-07 .product-item .card-action {\n  padding-bottom: 15px !important;\n}\n}\n@media (max-width: 992px) and (min-width: 552px) {\n  .custom-image-banner-block .halo-item .customImageBanner-child {\n    padding-left: 0 !important;\n    padding-right: 0 !important;\n  }\n}\n  @media (max-width: 815px) {\n    .custom-image-banner-block .customImageBanner-child:last-child .content_absolute .content h3 .link_title span:before {\n      content:normal;\n    }\n  }\n@media (max-width: 767px) {\n  .custom-image-banner-block .content_absolute .content h3 .link_title span:before {\n   /* content:normal; */\n  }\n  .grouped_btn--slider {\n    bottom: 12%;\n  display: flex;\n  gap: .75em;\n  }\n  .slideshow .slide-content .slide-button,\n  .custom-image-banner-block .content_absolute .content h3,\n  .card-action .button {\nfont-size: clamp(1.5rem, 3.875vw, 16px) !important;\n    margin: 0 auto !important;\n  }\n}\n@media (max-width: 660px) {\n\n .product-card-layout-03 .card-action,\n .product-card-layout-01 .product-item .card-action, .product-card-layout-04 .product-item .card-action, .product-card-layout-03 .product-item .card-action, .product-card-layout-07 .product-item .card-action {\n\n  margin-top:-3em !important;\n  padding-bottom: 5px !important;\n }\n}\n@media (max-width: 600px) {\n  .slideshow .slide-content .slide-button,\n  .custom-image-banner-block .content_absolute .content h3,\n  .card-action .button{\n    font-size:15px !important;\n  } \n\n  .slideshow .slide-content {\n   \n    bottom: 16px;\n  }\n}\n\n@media (max-width: 440px) {\n  .custom-image-banner-block .content_absolute .content h3 .link_title span:before {\n    content:normal; \n  }\n  .slideshow .slide-content {\n   \n    bottom:calc(.25vw - 12px);\n  }\n}\n@media (hover: hover) {\n  .slideshow .slide-content .slide-button:hover,\n.custom-image-banner-block .content_absolute:hover .content h3,\n.card-action .button:hover {\n    animation: style_hover .375s ease-out forwards ; \n  }\n}  \n</style>"
      }
