    "custom_liquid_NwcH3q": {
      "type": "custom-liquid",
      "name": "Shop All",
      "settings": {
        "custom_liquid": "<!-- Shop all button -->\n<style>\n.id3a_rich-text__text.lower {\n  background: #fff;\n  text-align: center;\n  position: relative;\n  overflow: visible;\n  padding:.75em;\n\n  font-size: clamp(1.5rem, 1.625vw, 2.5rem);\n}\n\n  .id3a_rich-text__text.lower a { \n    display:inline-block;\n    background: var(--iamcolor);\n  box-shadow: 0 0.125em 0.5em #0004;\n  text-decoration: none !important;\n  color: #fff;\n  border: 0.125em solid #fff;\n  width: fit-content;\n  padding: 0.5em 1em !important;\n  border-radius: 0.375em;\n  font-size: inherit;\n  line-height: 1;\n  transition: 0.5s;\n  text-shadow: 0 1px 2px #0003;\n  pointer-events: all;\n  font-weight: 900;\n  z-index: 1000;\n  position: absolute;\n  /*\n  transform: translate(-50%, calc(-50% - 5px) );\n\n  top:50%;\n  left: 50%;  */\n  translate: -50% calc(-50% - 1em);\n  margin-bottom:2em !important;\n}\n@media (hover: hover) {\n  .id3a_rich-text__text.lower  a:hover {\n    background: var(--iamcolor);\n    animation: style_hover 0.375s ease-out forwards;\n  }\n}\n</style>\n\n<div class=\"id3a_rich-text__text lower \"><a href=\"/collections/all\" class=\"text_link\">Shop All</a></div>"
      }
    }
