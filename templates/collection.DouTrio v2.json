        "custom_liquid": "<style>\n\n/* */\nbody.toolbar-modal-open .toolbar .dropdown-menu.hidden-on-desktop {\n  padding-bottom: 46px;\n}\n@media (max-width: 1024px) {\n  .toolbar .toolbar-dropdown.filter-sortby .label-tab.hidden-on-desktop {\n    padding: 4px 21px 4px 0 !important;\n  }\n  .toolbar .toolbar-dropdown .label-tab.hidden-on-desktop .icon-dropdown {\n    right: 5px;\n  }\n}\n.productList li {\n  max-width: 990px;\n  display: block !important;\n}\n/*\n.card-product:hover .card-media > img {\n  opacity: 1;\n  transform: scale(1.05);\n  transition: opacity .5s,transform 2s cubic-bezier(0,0,.44,1.18),-webkit-transform 2s cubic-bezier(0,0,.44,1.18);\n}\n/*\n.card-link {z-index: 11 !important;\n}*/\n.productList .card-information__wrapper .card-information__group .card-vendor,\n.productList .card-information__wrapper .card-title {\n  font-weight: 900;\n  font-size: 30px;\n  height: auto;\n  margin:20px 0 ;\n}\n.productList .card-information {\n  max-width: 600px;\n  display: flex !important;\n  flex-direction: column;\n  justify-content: space-between;\n}\n.productList .card-information,\n.productList li {\n  margin-right: auto;\n  margin-left: auto;\n}\n@media (min-width: 992px) {\n  .productList.list-4 .card-product,\n  .productList.list-5 .card-product {\n    width: calc(35% - 8px);\n  }\n}\n.variants-popup, .productList .card-list__hidden {\ndisplay:none;\n}\n.productListing .product {\n  cursor: pointer;\n}\n\n.productListing .card-action form {\n  display: none;\n}\n/*\n.productListing .card-action {pointer-events: none;}\n*/\n.productListing .card-action:before {\n    content: normal;\n  content: 'View';\n\n  display: block;\n  width: fit-content;\n  min-width: 130px;\n}\n@media only screen and (max-width: 680px) {\n .productListing .card-action:before {\n    min-width: 90px !important;\n  }\n}\n.productList .card-action .button,\n.productListing .card-action:before {\n /* margin: 20px 0  !important;\n  background: var(--iamcolor);\n  flex: 0 auto; *