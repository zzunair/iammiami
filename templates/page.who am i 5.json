size:cover;  background-clip: content-box;\n  }\n  }\n\n@keyframes image_top_animation {\n0%,15.9% {\n  background: var(--cholder_img_top1) center center no-repeat;\n  background-size:cover;  background-clip: content-box;\n  }\n  16%,32.9% {\n    background: var(--cholder_img_top2) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n  }\n  33%,49.9% {\n  background: var(--cholder_img_top3) center center no-repeat;\n  background-size:cover;  background-clip: content-box;\n  }\n\n  50%,65.9% {\n    background: var(--cholder_img_bottom1) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n    }\n  66%,82.9% {\n      background: var(--cholder_img_bottom2) center center no-repeat;\n      background-size:cover;  background-clip: content-box;\n    }\n  83%,99.9% {\n    background: var(--cholder_img_top4) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n    }\n\n100% {\n    background: var(--cholder_img_top1) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n}\n}\n@keyframes image_bottom_animation {\n  0%,15.9% {\n    background: var(--cholder_img_bottom1) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n    }\n  16%,32.9% {\n      background: var(--cholder_img_bottom2) center center no-repeat;\n      background-size:cover;  background-clip: content-box;\n    }\n  33%,49.9% {\n    background: var(--cholder_img_bottom3) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n    }\n\n    50%,65.9% {\n      background: var(--cholder_img_top1) center center no-repeat;\n      background-size:cover;  background-clip: content-box;\n      }\n      66%,82.9% {\n        background: var(--cholder_img_top2) center center no-repeat;\n        background-size:cover;  background-clip: content-box;\n      }\n      83%,99.9% {\n      background: var(--cholder_img_top3) center center no-repeat;\n      background-size:cover;  background-clip: content-box;\n      }\n  100% {\n    background: var(--cholder_img_bottom1) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n  }\n  }\n.collage_image_tall { \n  grid-area: 1 / 1 / 3 / 2; \naspect-ratio: .7;\nbackground: var(--cholder_img_tall1) center center no-repeat;\nbackground-size:cover;  background-clip: content-box;\nanimation-duration: var(--ani-duration) ;\nanimation-name: image_tall_animation;\nanimation-iteration-count: infinite;\nanimation-direction: forward;\nanimation-delay: calc(var(--ani-duration) / -12)\n} \n.collage_image_top { grid-area: 1 / 2 / 2 / 3;\n  background: var(--cholder_img_top1) center center no-repeat;\n  background-size:cover;\n  animation-duration: var(--ani-duration);\n  animation-name: image_top_animation;\n  animation-iteration-count: infinite;\n  animation-direction: forward;\n  animation-delay: calc(var(--ani-duration) / -8)\n} \n.collage_image_bottom { grid-area: 2 / 2 / 3 / 3; \n  background: var(--cholder_img_bottom1) center center no-repeat;\n  background-size:cover;\n  animation-duration: var(--ani-duration);\n  animation-name: image_bottom_animation;\n  animation-iteration-count: infinite;\n  animation-direction: forward;\n} \n@media only screen and (max-width:1100px) {\n  .collage_holder { \n    /*      _500x.jpg     */\n  /* these are the animated images */\n  --cholder_img_tall1: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_tall1_500x.jpg?v=1741291236); \n  --cholder_img_tall2: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_tall2_500x.jpg?v=1741291237); \n  --cholder_img_tall3: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_tall3_500x.jpg?v=1741291236); \n\n  --cholder_img_top1: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_top1_500x.jpg?v=1741291236);\n  --cholder_img_top2: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_top2_500x.jpg?v=1741291236);\n  --cholder_img_top3: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_top3_500x.jpg?v=1741291236);\n  --cholder_img_top4: #FFF url(\n    https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_top4_500x.jpg.jpg?v=1741295216);\n  --cholder_img_bottom1:url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_bottom1_500x.jpg?v=1741291236);\n  --cholder_img_bottom2:  url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_bottom2_500x.jpg?v=1741291236);\n  --cholder_img_bottom3:  url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_bottom3_500x.jpg?v=1741291236);\n  }\n\n\n}\n@media only screen and (max-width:768px) {\n  .collage_holder { \n    --cholder_gap: 10px;\n  }\n@media only screen and (max-width:500px) {\n  .collage_holder { \n        /*      _220x.jpg     */\n  /* these are the animated images */\n  --cholder_img_tall1: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_tall1_220x.jpg?v=1741291236); \n  --cholder_img_tall2: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_tall2_220x.jpg?v=1741291237); \n  --cholder_img_tall3: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_tall3_220x.jpg?v=1741291236); \n\n  --cholder_img_top1: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_top1_220x.jpg?v=1741291236);\n  --cholder_img_top2: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_top2_220x.jpg?v=1741291236);\n  --cholder_img_top3: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_top3_220x.jpg?v=1741291236);  \n  --cholder_img_top4: #FFF url(\n    https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_top4_220x.jpg.jpg?v=1741295216);\n  --cholder_img_bottom1:url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_bottom1_220x.jpg?v=1741291236);\n  --cholder_img_bottom2:  url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/I_3NY_bottom2_220x.jpg?v=1741291236);\n  --cholder_img_bottom3:  url(ht