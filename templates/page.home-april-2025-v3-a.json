    "custom_liquid_4n87cp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n\n\n.slideshow .slide-content {\n  height: 100%;\n  display: flex;\n  flex-direction:column;\n  justify-content: center;\n  gap: 2em;\n}\n.slideshow .slide-content > * {\n  flex: 0 0 auto;\n}\n.slideshow .slide-content .slide-button {\n  background: #8885;\nbox-shadow:0 .125em .5em #0004;\ncolor:var(--bc);\ncolor:#fff;\n  display: block;\n  border: .125em solid #fff;\n  width: fit-content;\n  padding: .5em 1em;\nborder-radius:.375em;\nfont-size:1.625vw;\nfont-size: clamp(1.5rem, 1.625vw, 3rem);\nline-height:1;\nbackdrop-filter: blur(4px);\ntransition: .5s;\ntext-shadow: 0 1px 2px #0003;\nmargin: 0 !important;\n}\n.slideshow .slide-content .slide-button:after {\ncontent:'Collection';\ndisplay:block;\nfont-weight:400;\n}\n.slideshow .slide-content .slide-button:hover {\n  background: var(--bc);\n  color:#fff;\n  border: .125em solid #fff;\n  text-shadow: 0 1px 2px #0003;\n  backdrop-filter: blur(10px);\n}\n.grouped_btn--slider {\n  justify-content: center;\n  gap: 2em;\n  align-self:flex-end;\nwidth: 100%;\nposition:absolute;\nbottom:125px;\nleft:0;\n}\n\n@media (max-width: 767px) {\n  .grouped_btn--slider {\n    bottom: 12%;\n  display: flex;\n  gap: .75em;\n  }\n  .slideshow .slide-content .slide-button {\n\nfont-size: clamp(1.5rem, 3.875vw, 2rem);\n    margin: 0 !important;\n  }\n}\n@media (max-width: 600px) {\n  .slideshow .slide-content .slide-button {\n    font-size:3.875vw;\n  }\n}\n@media (hover: hover) {\n  .slideshow .slide-content .slide-button:hover {\n    animation: style_hover .375s ease-out forwards ; \n  }\n}\n@keyframes style_hover {\n\n  0% {\n    transform:perspective(1000px) rotateY(0)rotateZ(0) rotateX(0) scale(1) translate(0 , 0);\n  }\n  25% {\ntransform:perspective(1000px) rotateY(20deg)rotateZ(0) rotateX(0) scale(1.1) translate(-2% , 0);\n  }\n  50% {\n    transform:perspective(1000px) rotateY(-10deg)rotateZ(0) rotateX(0) scale(1.1) translate(1% , 0);\n  }  \n   75% {\ntransform:perspective(1000px) rotateY(5deg)rotateZ(0) rotateX(0) scale(1.1) translate(-.5% , 0);\n  }\n  100% {\n    transform:perspective(1000px) rotateY(0)rotateZ(0) rotateX(0) scale(1.1) translate(0 , 0);\n  }\n}\n</style>"
      }
    },
