      "settings": {
        "custom_liquid": "<div class=\"collage_holder\"> \n<div class=\"collage_image_1\"> </div> \n<div class=\"collage_image_2\"> </div> \n<div class=\"collage_image_3\"> </div> \n</div>\n<style>\n.collage_holder { \n  --cholder_color: #e1dad4;\n  --cholder_gap: 20px;  \n  --ani-duration:20s;\n  /* tall image that doesn't change */\n  --cholder_img0: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-2_1000x.jpg?v=1713381401); \n  /* these are the animated images */\n  --cholder_img1: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-3_1000x.jpg?v=1713381402);\n  --cholder_img2: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-5_39e02273-2fdd-4241-8d48-4dbc17dc01f9_1000x.jpg?v=1715271739);\n  --cholder_img3:url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-4_1000x.jpg?v=1713381402);\n  --cholder_img4:  url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/miami-ny-Cafecito_1000x.jpg?v=1713463988);\n\n  background: var(--cholder_color);\ndisplay: grid; \ngrid-template-columns: repeat(2, 1fr); \ngrid-template-rows: repeat(2, 1fr); \ngrid-column-gap: var( --cholder_gap);\ngrid-row-gap: var( --cholder_gap); \n}\n.collage_holder:before {\n  content: '';\n  background: var(--cholder_img3), var(--cholder_img4), var(--cholder_img1), var(--cholder_img2), var(--iamcolor);\n  background-size:1px ;\nbackground-position:-100vw;\nposition: absolute;\nz-index: -10;\n}\n@keyframes image_2_animation {\n0%,24.9% {\n  background: var(--cholder_img1) center center no-repeat;\n  background-size:cover;  background-clip: content-box;\n  }\n  25%,49.9% {\n    background: var(--cholder_img2) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n  }\n  50%,74.9% {\n  background: var(--cholder_img3) center center no-repeat;\n  background-size:cover;  background-clip: content-box;\n  }\n  75%,99.9% {\n    background: var(--cholder_img4) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n  }\n100% {\n    background: var(--cholder_img1) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n}\n}\n@keyframes image_3_animation {\n  0%,24.9% {\n    background: var(--cholder_img3) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n    }\n  25%,49.9% {\n      background: var(--cholder_img4) center center no-repeat;\n      background-size:cover;  background-clip: content-box;\n    }\n  50%,74.9% {\n    background: var(--cholder_img1) center center no-repeat;\n    background-size:cover;  background-clip: content-box;\n    }\n  75%,99.9% {\n      background: var(--cholder_img2) center center no-repeat;\n      background-size:cover;  background-clip: content-box;\n    }\n  100% {\n      background: var(--cholder_img3) center center no-repeat;\n      background-size:cover;  background-clip: content-box;\n  }\n  }\n.collage_image_1 { \n  grid-area: 1 / 1 / 3 / 2; \naspect-ratio: .7;\nbackground: var(--cholder_img0) center center no-repeat;\nbackground-size:cover;  background-clip: content-box;\n} \n.collage_image_2 { grid-area: 1 / 2 / 2 / 3;\n  background: var(--cholder_img1) center center no-repeat;\n  background-size:cover;\n  animation-duration: var(--ani-duration);\n  animation-name: image_2_animation;\n  animation-iteration-count: infinite;\n  animation-direction: forward;\n  animation-delay: calc(var(--ani-duration) / -8)\n} \n.collage_image_3 { grid-area: 2 / 2 / 3 / 3; \n  background: var(--cholder_img3) center center no-repeat;\n  background-size:cover;\n  animation-duration: var(--ani-duration);\n  animation-name: image_3_animation;\n  animation-iteration-count: infinite;\n  animation-direction: forward;\n} \n@media only screen and (max-width:1100px) {\n  .collage_holder { \n    --cholder_img0: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-2_500x.jpg?v=1713381401); \n    --cholder_img1: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-3_500x.jpg?v=1713381402);\n    --cholder_img2: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-5_39e02273-2fdd-4241-8d48-4dbc17dc01f9_500x.jpg?v=1715271739);\n    --cholder_img3:url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-4_500x.jpg?v=1713381402);\n    --cholder_img4:  url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/miami-ny-Cafecito_500x.jpg?v=1713463988);\n  }\n}\n@media only screen and (max-width:768px) {\n  .collage_holder { \n    --cholder_gap: 10px;\n  }\n@media only screen and (max-width:500px) {\n  .collage_holder { \n    --cholder_img0: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-2_220x.jpg?v=1713381401); \n    --cholder_img1: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-3_220x.jpg?v=1713381402);\n    --cholder_img2: url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-5_39e02273-2fdd-4241-8d48-4dbc17dc01f9_220x.jpg?v=1715271739);\n    --cholder_img3:url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/mIAMi-NY-4_220x.jpg?v=1713381402);\n    --cholder_img4:  url(https://cdn.shopify.com/s/files/1/0842/9400/9146/files/miami-ny-Cafecito_220x.jpg?v=1713463988);\n  }\n}\n</style>"
