t-shadow: 0 1px 2px #0003;\n    width: fit-content;\n    padding: .5em 1em !important;\n  \n  backdrop-filter: blur(4px);\n  transition: 0s !important;\n  \n  \n  }\n  .card-group-abs-center,\n  .card-action {\n    transition: 0s !important;\n  }\n  \n  .product-card-layout-03 .card-action {\n    margin: 0 auto !important;\n    max-width:100%;\n  }\n   .productView-action .button:hover {\n  border-color:var(--iamcolor);\n  color:var(--iamcolor);\n  box-shadow:0 .125em .5em #0004;\n  }\n  .card-action .button:hover {\n    background: var(--iamcolor);\n    color:#fff;\n    border: .125em solid #fff;\n    text-shadow: 0 1px 2px #0003;\n    box-shadow:0 .125em .5em #0004;\n  }\n  @media (max-width: 1024px) {\n   .productList  .card-media + .card-group-abs-center {\n      display: none;\n    }\n    .product-card-layout-01 .product-item .card-action, .product-card-layout-04 .product-item .card-action, .product-card-layout-03 .product-item .card-action, .product-card-layout-07 .product-item .card-action {\n      display: block !important;\n      margin-top:-3.5em !important;\n      padding-bottom: 15px !important;\n  }\n  }\n  @media (max-width: 767px) {\n   .productList.productListing .product .card-summary.card-list__hidden {\n      display:block !important;\n    }\n    .custom-image-banner-block .content_absolute .content h3 .link_title span:before {\n      content:normal;\n    }\n    .grouped_btn--slider {\n      bottom: 12%;\n    display: flex;\n    gap: .75em;\n    }\n    .product-card-layout-01 .product-item .card-action, .product-card-layout-04  .product-item .card-action, .product-card-layout-03 .product-item .card-action, .product-card-layout-07 .product-item .card-action{\n     display: block !important;\n     margin-top:-3em !important;\n     padding-bottom: 5px !important;\n  }\n    .card-action .button, .productView-action .button { \n  font-size: clamp(1.5rem, 3.875vw, 16px)!important;\n      margin: 0 auto !important;\n    }\n  }\n  @media (max-width: 600px